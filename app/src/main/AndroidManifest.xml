<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- LAN sync (`quire-core`'s own protocol, port 5878 / discovery 5879) and,
         later, the read-only LAN share. The permission is all this shell can ask
         for: no manifest permission covers UDP broadcast reception, and there is
         no multicast lock, so discovery is best-effort — a network that filters
         broadcasts leaves 已发现的设备 empty rather than offering a by-hand door. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Which transport the default route uses (ADR-0032). Normal permission,
         no prompt: it is how the sync cadence knows whether this device is on
         Wi-Fi, so a phone on mobile data does not dial the LAN every ten
         seconds. `ConnectivityManager` cannot answer it without this, and it is
         the only new permission the aggressive-on-Wi-Fi policy costs. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- 二维码传输: reading the other device's sync code, and nothing else. The
         prompt is asked when 「扫码接收」 is pressed rather than at launch, which
         is what makes the request answerable when the user finally sees it. -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- A phone without a camera can still show a code and still be reached by
         one, so this is optional rather than required: `required="false"` keeps
         the app installable on a camera-less device, where only 出码 is drawn in
         practice (the scan button reports the missing camera). -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.Quire">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|keyboardHidden|screenSize|smallestScreenSize|screenLayout|density|uiMode|fontScale"
            android:theme="@style/Theme.Quire">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The 同步 page's 扫码接收. Not exported and not in the launcher: it is
             a step inside this app, and it needs nothing from outside it. The
             attributes are the library's own `CaptureActivity` ones, including
             its `zxing_CaptureTheme` — that theme is what the capture layout is
             written against, and `sensorLandscape` is the orientation the scanner
             asks for (`setOrientationLocked`). -->
        <activity
            android:name=".QrCaptureActivity"
            android:clearTaskOnLaunch="true"
            android:exported="false"
            android:stateNotNeeded="true"
            android:screenOrientation="sensorLandscape"
            android:windowSoftInputMode="stateAlwaysHidden"
            android:theme="@style/zxing_CaptureTheme" />
    </application>

</manifest>
